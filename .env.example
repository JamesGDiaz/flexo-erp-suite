# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------

# Keep version tags immutable. Do not use "latest" in production.
COMPOSE_PROJECT_NAME=cutrdflexo-prod
CUTRDFLEXO_IMAGE=git.roselabs.mx/roselabs/cutrdflexo
CUTRDFLEXO_VERSION=v0.5.0

# Host-side port used by Nginx. The Go process still listens on :5600
# inside the container.
APP_PORT=5600


# -----------------------------------------------------------------------------
# PostgreSQL - external DigitalOcean managed database
# -----------------------------------------------------------------------------

# Use the exact production connection details supplied by DigitalOcean.
# Keep TLS enabled. If DigitalOcean supplies a CA-based connection string,
# prefer it over this illustrative form.
DATABASE_URL=postgresql://cutrdflexo:CHANGE_ME@db.example-do-user-123456-0.c.db.ondigitalocean.com:25060/cutrdflexo?sslmode=require

DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m


# -----------------------------------------------------------------------------
# Valkey - private Compose service
# -----------------------------------------------------------------------------

# Generate a long random password, for example:
#   openssl rand -hex 32
VALKEY_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
VALKEY_DB=0


# -----------------------------------------------------------------------------
# S3-compatible object storage
# -----------------------------------------------------------------------------

# DigitalOcean Spaces example:
#   S3_ENDPOINT_INTERNAL=https://nyc3.digitaloceanspaces.com
#   S3_ENDPOINT_PUBLIC=https://nyc3.digitaloceanspaces.com
#   S3_REGION=nyc3
#
# If you enable a Spaces CDN/custom public domain later, S3_ENDPOINT_PUBLIC
# may differ from S3_ENDPOINT_INTERNAL.
S3_ENDPOINT_INTERNAL=https://REGION.digitaloceanspaces.com
S3_ENDPOINT_PUBLIC=https://REGION.digitaloceanspaces.com
S3_REGION=REGION
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=cutrdflexo-production

# DigitalOcean Spaces normally uses virtual-hosted-style access.
S3_USE_PATH_STYLE=false


# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CutRDFlexo <noreply@crdflexo.mx>

# One of: none, starttls, tls
SMTP_TLS_MODE=starttls


# -----------------------------------------------------------------------------
# Browser applications / trusted origins
# -----------------------------------------------------------------------------

STAFF_APP_ORIGIN=https://dashboard.crdflexo.mx
PORTAL_APP_ORIGIN=https://portal.crdflexo.mx
HOMEPAGE_APP_ORIGIN=https://www.crdflexo.mx


# -----------------------------------------------------------------------------
# Sessions / security
# -----------------------------------------------------------------------------

STAFF_SESSION_COOKIE_NAME=__Host-crdf_staff_session
PORTAL_SESSION_COOKIE_NAME=__Host-crdf_portal_session

REMEMBER_SESSION_TTL=168h
NON_REMEMBER_SESSION_TTL=24h
INVITATION_TTL=168h
PASSWORD_RESET_TTL=1h

SESSION_SECURE=true


# -----------------------------------------------------------------------------
# Documents / Chromium
# -----------------------------------------------------------------------------

# The release image already contains Chromium and sets its executable path.
DOCUMENT_RENDER_TIMEOUT=20s
DOCUMENT_RENDER_CONCURRENCY=2


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
