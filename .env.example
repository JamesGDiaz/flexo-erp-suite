# Production template. For staging use .env.staging.example instead.
# Copy to .env; chmod 600 .env. Never store migration-owner credentials here.
COMPOSE_PROJECT_NAME=cutrdflexo-prod
# Full image reference. Confirm publication; v0.5.0-ps is an example, not a claim
# that this release succeeded. Prefer repository@sha256:VERIFIED_DIGEST.
CUTRDFLEXO_IMAGE=git.roselabs.mx/roselabs/cutrdflexo:v0.5.0-ps
APP_PORT=5600
INSTALLATION_ID=cutrd-production
APP_DISPLAY_NAME=CutRDFlexo
# Must match image: -ps=true, -nops=false. Checked at app startup.
CAPABILITY_PRICING_SUGGESTIONS=true

# Runtime role only. URL-encode the password and verify the provider certificate.
DATABASE_URL=postgresql://cutrd_runtime:CHANGE_ME@DB_HOST:25060/cutrd?sslmode=verify-full
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m

VALKEY_IMAGE=valkey/valkey:9.1.2-alpine
VALKEY_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Private existing bucket, scoped credentials; adjust path style to your provider.
S3_ENDPOINT_INTERNAL=https://REGION.digitaloceanspaces.com
S3_REGION=REGION
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=cutrdflexo-production
S3_USE_PATH_STYLE=false
# S3_ENDPOINT_PUBLIC is reserved; it does not make the bucket public.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CutRDFlexo <noreply@example.com>
SMTP_TLS_MODE=starttls

STAFF_APP_ORIGIN=https://staff.example.com
PORTAL_APP_ORIGIN=https://portal.example.com
HOMEPAGE_APP_ORIGIN=https://www.example.com
# Immediate proxy IP as seen by the container, not automatically 127.0.0.1.
HTTP_TRUSTED_PROXY_CIDRS=
STAFF_SESSION_COOKIE_NAME=__Host-cutrd_staff
PORTAL_SESSION_COOKIE_NAME=__Host-cutrd_portal
REMEMBER_SESSION_TTL=168h
NON_REMEMBER_SESSION_TTL=24h
INVITATION_TTL=168h
PASSWORD_RESET_TTL=1h
# Generate with openssl rand -base64 32. Keep stable and back up separately.
TOTP_ENCRYPTION_KEY=CHANGE_ME

DOCUMENT_RENDER_TIMEOUT=20s
DOCUMENT_RENDER_CONCURRENCY=2
LOG_LEVEL=info
LOG_FORMAT=json
